VITE_APP_VERSION=v1.0.1
GENERATE_SOURCEMAP=false

# ---------------------------------------------------------------------------
# Multi-tenancy
#
# Each college is a subdomain, and the same slug addresses both halves of the
# product: the app runs on client1.<app-domain> and calls client1.<api-domain>.
# The slug is read from window.location.hostname, so nothing below names a
# specific college.
#
#   app  http://client1.localhost:3000
#   api  http://client1.localhost:8000/api/v1/internal
# ---------------------------------------------------------------------------

VITE_PUBLIC_APP_HTTP_SCHEME=http://
VITE_PUBLIC_APP_BASE_URL=localhost:8000/api
VITE_PUBLIC_APP_API_VERSION=v1/internal

# Escape hatch: point a local frontend at one specific tenant without editing
# /etc/hosts. Set this and the subdomain is ignored entirely.
# VITE_API_URL=http://client1.localhost:8000/api/v1/internal

# Force a college slug regardless of hostname (useful on a plain localhost).
# VITE_TENANT_SLUG=client1

VITE_APP_BASE_NAME=/
